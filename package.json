{
  "name": "vue-floating-panels",
  "version": "1.0.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ppnoHZ/vue-popup.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:interaction": "node scripts/benchmark-interactions.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json && node scripts/finalize-types.mjs",
    "check:lib": "node scripts/verify-package.mjs",
    "pack:lib": "npm run build:lib && npm run check:lib && npm pack && node scripts/test-package.mjs"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "vue": "^3.5.44",
    "ant-design-vue": "^4.2.6"
  },
  "description": "Vue 3 draggable, resizable popup, modal and drawer components",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./style.css": "./lib/style.css"
  },
  "files": [
    "lib",
    "README.md",
    "src/components/DraggablePopup/MIGRATION.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
